{
  "schema": "photo-grading/request@1",
  "project": {
    "project_id": "teal-orange-leopard",
    "options": {"overwrite": true},
    "source": {"source_id": "photo.png", "path": "photo.png"},
    "operations": [
      {"op_id": "corr", "type": "PHOTO_CORRECTION", "input": "source",
       "parameters": {
         "white_balance_temperature": 6700, "white_balance_tint": 2,
         "exposure": 0.02, "contrast": 14, "saturation": 3, "vibrance": 28,
         "clarity": 3, "sharpness": 2,
         "shadows": -3, "highlights": -18,
         "tone_blacks": 0.006, "tone_shadows": 0.14, "tone_midtones": 0.525,
         "tone_highlights": 0.86, "tone_whites": 0.995
       }},
      {"op_id": "split", "type": "PHOTO_GRADING", "input": "op:corr",
       "parameters": {
         "shadows_hue": 182, "shadows_saturation": 24, "shadows_luminance": -2,
         "midtones_hue": 0, "midtones_saturation": 28,
         "highlights_hue": 350, "highlights_saturation": 75, "highlights_luminance": -5,
         "blending": 68, "balance": 0, "strength": 1.0
       }}
    ],
    "outputs": [
      {"output_id": "final_png", "operation": "op:split", "path": "teal_orange_leopard.png", "format": "png"},
      {"output_id": "final_jpg", "operation": "op:split", "path": "teal_orange_leopard.jpg", "format": "jpg"}
    ]
  }
}
